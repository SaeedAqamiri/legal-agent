# Legal Agent — runtime configuration (copy to .env and adjust).
# Required for production/Deployment; the app falls back to in-memory when unset.

# HTTP server
LEGAL_AGENT_HOST=0.0.0.0
LEGAL_AGENT_PORT=8000
LEGAL_AGENT_LOG_LEVEL=info

# PostgreSQL (durable canonical data + research history)
LEGAL_AGENT_POSTGRES_DSN=postgresql://legal_agent:legal_agent@localhost:5432/legal_agent
LEGAL_AGENT_POSTGRES_MIGRATE=true

# FalkorDB (durable progressive-research graph overlay)
FALKORDB_URL=falkor://localhost:6379
LEGAL_AGENT_FALKOR_PREFIX=legal_graph

# Local/embedded JSON history fallback (used only when Postgres is disabled)
LEGAL_AGENT_HISTORY_PATH=

# ---- OpenID Connect (external Identity Provider). Enable to replace manual tokens.
# Required endpoints resolved from the IdP discovery document.
LEGAL_AGENT_OIDC_ISSUER=
LEGAL_AGENT_OIDC_CLIENT_ID=
LEGAL_AGENT_OIDC_CLIENT_SECRET=
LEGAL_AGENT_OIDC_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
LEGAL_AGENT_OIDC_AUTHORIZATION_ENDPOINT=
LEGAL_AGENT_OIDC_TOKEN_ENDPOINT=
LEGAL_AGENT_OIDC_JWKS_URI=
# HMAC secret used to sign short-lived browser session cookies (>= 32 bytes).
LEGAL_AGENT_SESSION_SECRET=replace-me-with-a-long-random-secret

# Optional static bearer tokens (JSON) for local/test mode only.
# e.g. {"researcher-demo":{"actor_id":"r1","organization_id":"org-a","roles":["researcher"]}}
LEGAL_AGENT_STATIC_TOKENS=

# Default tenant used when an identity claim is absent.
LEGAL_AGENT_ORGANIZATION=org-a
